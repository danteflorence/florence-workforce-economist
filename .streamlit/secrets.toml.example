# ─────────────────────────────────────────────────────────────────────
# Florence Workforce Economist — secrets template
# Copy to .streamlit/secrets.toml (gitignored) and fill in real values.
# The app stays OPEN (no login) until a valid [auth] section exists here.
# ─────────────────────────────────────────────────────────────────────

# ── Google sign-in (Streamlit native OIDC) ──────────────────────────
# Provision a Google Cloud OAuth 2.0 "Web application" client:
#   APIs & Services → Credentials → Create credentials → OAuth client ID
# Authorized redirect URIs must list BOTH of these (whichever you use):
#   http://localhost:8501/oauth2callback
#   https://florence-workforce-economist.streamlit.app/oauth2callback
[auth]
redirect_uri = "https://florence-workforce-economist.streamlit.app/oauth2callback"
cookie_secret = "CHANGE_ME — a long random string, e.g. `python -c 'import secrets;print(secrets.token_hex(32))'`"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# Optional — restrict access to your workspace domain(s), comma-separated.
# (Also settable via env: FLORENCE_ALLOWED_DOMAIN=florenceeducation.com)
allowed_domain = "florenceeducation.com"

# Multi-provider form (alternative to the single-provider block above) — then
# the app calls st.login("google"):
# [auth.google]
# client_id = "xxxxxxxx.apps.googleusercontent.com"
# client_secret = "xxxxxxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── CRM / outreach integrations (all optional, dormant until set) ────
# Streak CRM — Settings → Integrations → API key
# STREAK_API_KEY is read from the environment, not secrets (see crm_sync.py).
#
# Gmail drafts — uses the SAME Google OAuth client above, plus the
# gmail.compose scope and a one-time consent (see crm_sync.py / GMAIL_TOKEN_FILE).
#
# Lob direct mail — LOB_API_KEY (env). Return address: FLORENCE_RETURN_NAME/
# LINE1/CITY/STATE/ZIP. Self-scheduling link for the outreach email:
# FLORENCE_CALENDAR_URL. Activation portal base: FLORENCE_SIGNUP_URL.
#
# Stripe — Payment Link URLs (public, not secret). Create two products in
# Stripe (recurring subscription + one-time placement), make a Payment Link for
# each, then set:
#   STRIPE_CHECKOUT_URL      → activation portal "add payment method" button
#   STRIPE_SUBSCRIPTION_URL  → public calculator subscription CTA
#   STRIPE_PLACEMENT_URL     → public calculator placement CTA
#   FLORENCE_CONTACT_EMAIL   → mailto fallback when a link isn't set yet
# For exact per-deal amounts, set STRIPE_SECRET_KEY too (dynamic Checkout).
#
# AI-personalized outreach openers — ANTHROPIC_API_KEY (dormant; falls back to a
# rule-based opener from local data when unset).
