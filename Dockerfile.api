# Florence Pricing API — stateless FastAPI wrapper around pricing_engine.price().
# Tiny image: only fastapi/uvicorn (the engine is pure stdlib). No data, no secrets.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt
# pricing_api imports pricing_engine (pure stdlib); copy the root .py modules.
COPY *.py ./
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn pricing_api:app --host 0.0.0.0 --port ${PORT:-8000}"]
