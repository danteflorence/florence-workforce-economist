# ─── Secrets (NEVER commit) ─────────────────────────────────────────
data/.auth_secret
data/auth_otp_outbox.log
data/auth_users.csv
data/auth_sessions.csv
data/auth_otp_codes.csv
# Rep-entered customer-contact overrides (mutable data, not code)
data/contact_overrides.csv
# Direct-mail send/response log (mutable)
data/mail_log.csv
# Customer activation signups (mutable)
data/activations.csv
# Account activity log — calls/notes/timeline (mutable)
data/activity_log.csv
# System ownership — rep assignments (mutable)
data/system_owners.csv
# Snooze / reminders (mutable)
data/snoozes.csv
# Call-center claim locks (mutable)
data/call_claims.csv
# Server-side error log (error_monitoring.py; mutable)
data/errors.log
.env
.env.*
secrets.toml
.streamlit/secrets.toml

# ─── Runtime pipeline data (rep PII; lazily re-created on first read) ─
data/growth_employer_pipeline.csv
data/growth_university_pipeline.csv

# ─── Raw source data (large, public — re-downloadable) ──────────────
# CMS HCRIS raw zips
data/hcris_raw/

# CMS PECOS raw enrollment files
data/raw_cms_pecos/

# CMS non-hospital provider raw files
data/raw_cms_non_hospital/

# Geo source files (can re-download from Census) — except the small ZIP→CBSA
# crosswalk, which the Market Map needs at runtime on Streamlit Cloud.
data/geo/*
!data/geo/zip_cbsa.csv

# Large Gazetteer files (Census, re-downloadable)
data/2024_Gaz_zcta_national.txt

# ─── Backups + working files ────────────────────────────────────────
data/backups/
data/*.bak_*
data/*.bak.*
*.swp
*.swo
*~

# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Streamlit ──────────────────────────────────────────────────────
.streamlit/credentials.toml

# ─── OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Output bundles (regenerated on demand) ─────────────────────────
data/output/*.xlsx
data/output/*.pdf
data/output/*.pptx

# CI workflows are tracked. If a push is rejected with "refusing to allow a
# Personal Access Token to create or update workflow", the stored PAT needs
# the `workflow` scope added at github.com/settings/tokens.
